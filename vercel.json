{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/internal/scrape/refresh",
      "schedule": "0 6 * * *"
    }
  ],
  "services": {
    "frontend": {
      "root": "client",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "app.ts",
      "buildCommand": "npm run db:deploy --workspace server",
      "bindings": [
        {
          "type": "service",
          "service": "scraper",
          "format": "url",
          "env": "POWERLEAGUE_SCRAPER_URL"
        }
      ],
      "functions": {
        "app.ts": {
          "maxDuration": 30,
          "regions": ["lhr1"]
        }
      }
    },
    "scraper": {
      "root": "scraper",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 30,
          "regions": ["lhr1"]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
