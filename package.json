{
  "name": "24-hour-party-people",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.2"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:test:down": "docker compose --profile test rm --force --stop postgres-test",
    "db:test:up": "docker compose --profile test up --detach --wait postgres-test",
    "db:studio": "npm run db:studio --workspace server",
    "db:up": "docker compose up -d postgres",
    "dev:client": "npm run dev --workspace client",
    "dev:scraper": "cd scraper && ../.venv/bin/python -m uvicorn app:app --reload --port 8001",
    "dev:server": "npm run dev --workspace server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspaces --if-present",
    "postinstall": "npm run db:generate",
    "test": "bash scripts/test.sh",
    "test:scraper": ".venv/bin/python -m pytest scraper/tests",
    "test:workspaces": "npm run test --workspaces --if-present && npm run test:scraper",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vercel:build": "npm run db:deploy --workspace server && npm run build --workspace client"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
